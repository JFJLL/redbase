{
  "schemaVersion": 2,
  "version": 2,
  "defaultRisk": "R1",
  "riskOrder": {
    "R0": 0,
    "R1": 1,
    "R2": 2,
    "R3": 3
  },
  "changeScope": {
    "strategy": "merge-base",
    "baseRef": "origin/master",
    "includeUntracked": true,
    "excludePaths": [
      "^\\.verification/",
      "^artifacts/verification/",
      "(^|/)node_modules/",
      "\\.db$",
      "\\.db-shm$",
      "\\.db-wal$",
      "(^|/)dist/",
      "\\.exe$"
    ]
  },
  "baseLanes": {
    "R0": [
      "static"
    ],
    "R1": [
      "static",
      "unit"
    ],
    "R2": [
      "static",
      "unit",
      "integration"
    ],
    "R3": [
      "static",
      "unit",
      "integration",
      "smoke"
    ]
  },
  "routes": [
    {
      "id": "docs-only",
      "risk": "R0",
      "includeAny": [
        "(^|/)docs?/",
        "\\.md$",
        "\\.txt$"
      ],
      "addLanes": []
    },
    {
      "id": "user-interface",
      "risk": "R2",
      "includeAny": [
        "(^|/)(app|pages|public|components|ui|frontend)/",
        "\\.(tsx|jsx|vue|svelte|css|scss|less)$"
      ],
      "exclude": [
        "(^|/)(server|api|backend)/"
      ],
      "addLanes": [
        "kimi-browser"
      ],
      "evidenceCases": [
        "KIMI-001"
      ]
    },
    {
      "id": "api-contract",
      "risk": "R2",
      "includeAny": [
        "(^|/)(api|routes?|controllers?|server)/",
        "openapi",
        "schema\\.(json|ya?ml)$"
      ],
      "addLanes": [
        "integration"
      ]
    },
    {
      "id": "ai-behavior",
      "risk": "R2",
      "includeAny": [
        "(^|/)(ai|llm|prompts?|agents?|models?|evals?)/",
        "(prompt|generation|inference|anysearch)"
      ],
      "exclude": [
        "(^|/)components/",
        "\\.test\\.",
        "spec\\."
      ],
      "addLanes": [
        "ai-eval",
        "agent-review"
      ],
      "evidenceCases": [
        "KIMI-001",
        "KIMI-006"
      ]
    },
    {
      "id": "data-state",
      "risk": "R3",
      "includeAny": [
        "(^|/)(db|database|migrations?|prisma|repositories|storage)/",
        "(schema|migration|repository|persistence)"
      ],
      "addLanes": [
        "integration",
        "data",
        "agent-review"
      ]
    },
    {
      "id": "critical-user-journey",
      "risk": "R3",
      "includeAny": [
        "(auth|permission|tenant|credit|billing|payment|cookie|session)"
      ],
      "exclude": [
        "(^|/)docs?/",
        "\\.md$",
        "\\.txt$",
        "\\.test\\.",
        "spec\\."
      ],
      "addLanes": [
        "integration",
        "kimi-browser",
        "agent-review"
      ],
      "evidenceCases": [
        "KIMI-001",
        "KIMI-004"
      ]
    },
    {
      "id": "critical-processing",
      "risk": "R3",
      "includeAny": [
        "(queue|worker|retry|idempot)"
      ],
      "addLanes": [
        "integration",
        "agent-review"
      ]
    },
    {
      "id": "deployment",
      "risk": "R3",
      "includeAny": [
        "(^|/)(deploy|infra|docker|scripts/release|\\.github/workflows)/",
        "(Dockerfile|wrangler\\.toml|nginx)"
      ],
      "addLanes": [
        "smoke",
        "agent-review"
      ]
    }
  ],
  "lanes": {
    "static": {
      "kind": "command",
      "modes": [
        "local",
        "ci"
      ],
      "minExecuted": 2,
      "commands": [
        {
          "id": "diff-check",
          "program": "git",
          "args": [
            "diff",
            "--check"
          ],
          "required": true,
          "hygiene": true
        },
        {
          "id": "project-check",
          "program": "npm.cmd",
          "args": [
            "run",
            "check"
          ],
          "npmScript": "check",
          "required": true
        },
        {
          "id": "typecheck",
          "program": "npm.cmd",
          "args": [
            "run",
            "typecheck:frontend"
          ],
          "npmScript": "typecheck:frontend",
          "required": false
        }
      ]
    },
    "unit": {
      "kind": "command",
      "modes": [
        "local",
        "ci"
      ],
      "minExecuted": 1,
      "commands": [
        {
          "id": "unit",
          "program": "npm.cmd",
          "args": [
            "run",
            "test"
          ],
          "npmScript": "test",
          "required": true
        }
      ]
    },
    "build": {
      "kind": "command",
      "modes": [
        "local",
        "ci"
      ],
      "minExecuted": 1,
      "commands": [
        {
          "id": "build",
          "program": "npm.cmd",
          "args": [
            "run",
            "build"
          ],
          "npmScript": "build",
          "required": false
        }
      ]
    },
    "integration": {
      "kind": "command",
      "modes": [
        "local",
        "ci"
      ],
      "minExecuted": 1,
      "commands": [
        {
          "id": "integration",
          "program": "npm.cmd",
          "args": [
            "run",
            "test:integration"
          ],
          "npmScript": "test:integration",
          "required": true
        }
      ]
    },
    "smoke": {
      "kind": "command",
      "modes": [
        "local",
        "ci",
        "release"
      ],
      "minExecuted": 1,
      "commands": [
        {
          "id": "smoke-api",
          "program": "npm.cmd",
          "args": [
            "run",
            "smoke:api"
          ],
          "npmScript": "smoke:api",
          "required": false
        }
      ]
    },
    "ai-eval": {
      "kind": "command",
      "modes": [
        "local",
        "ci"
      ],
      "minExecuted": 1,
      "commands": [
        {
          "id": "ai-eval",
          "program": "npm.cmd",
          "args": [
            "run",
            "eval:ai"
          ],
          "npmScript": "eval:ai",
          "required": false
        }
      ]
    },
    "data": {
      "kind": "command",
      "modes": [
        "local",
        "ci"
      ],
      "minExecuted": 1,
      "commands": [
        {
          "id": "data",
          "program": "npm.cmd",
          "args": [
            "run",
            "test:data"
          ],
          "npmScript": "test:data",
          "required": false
        }
      ]
    },
    "kimi-browser": {
      "kind": "evidence",
      "modes": [
        "local"
      ],
      "evidenceKey": "kimi-browser"
    },
    "agent-review": {
      "kind": "evidence",
      "modes": [
        "local"
      ],
      "evidenceKey": "agent-review"
    }
  }
}
